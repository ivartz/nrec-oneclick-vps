#cloud-config
# Network shield VM: default-deny egress gateway for the agent VM on the
# isolated "agentbox" libvirt network. Renders from deploy-local.sh sed tokens:
#   ${admin_user} ${admin_password} ${ssh_public_key} ${lan_mac} ${wan_mac} ${box_host} ${allow_domains}
#   (note: if ever rendered by Terraform templatefile() on the main branch, bash
#    ${1:-...} below must be escaped $${1:-...}; deploy-local.sh sed does not touch it)
# Design (YAGNI, UiO "profiler" thinking; F# = filter layers, L# = OSI):
#  - F1 (IP/port): nftables forward policy=drop; only web (80/443/QUIC) and NTP
#    to IPs that F2 (DNS) put in the allow4 set. Non-matching agent traffic is
#    REJECTED (not silently dropped) so the agent gets an immediate, legible
#    "network unreachable / connection refused" it can reason about.
#  - F2 (DNS): dnsmasq is the agent's only resolver; nftset= lines (from the
#    profile file) add resolved IPs of allowed domains to allow4, TTL-expiring.
#  - Monitoring: every query and deny is logged; "shield-report" summarizes.
#  - Enforcement lives OUTSIDE the agent VM: the agent has sudo on its own box
#    and could rewrite any firewall/rules there. L2 isolation on the hypervisor
#    network can't be undone from inside the guest.

timezone: Europe/Oslo

users:
  - name: ${admin_user}
    sudo: ALL=(ALL) NOPASSWD:ALL
    groups: sudo
    shell: /bin/bash
    lock_passwd: false
    ssh_authorized_keys:
      - ${ssh_public_key}

chpasswd:
  expire: false
  users:
    - name: ${admin_user}
      password: "${admin_password}"
      type: text

write_files:

  # Deterministic wan0/lan0 names BEFORE networkd/dnsmasq start: netplan's
  # match+rename only lands on the next coldplug, so nft iifname / dnsmasq
  # interface= raced against it and dnsmasq died with "unknown interface lan0".
  - path: /etc/udev/rules.d/42-shield-if.rules
    permissions: '0644'
    content: |
      SUBSYSTEM=="net", ACTION=="add", ATTR{address}=="${wan_mac}", NAME="wan0"
      SUBSYSTEM=="net", ACTION=="add", ATTR{address}=="${lan_mac}", NAME="lan0"

  - path: /usr/local/lib/shield/00-shield.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -euo pipefail
      export DEBIAN_FRONTEND=noninteractive HOME=/root
      export NEEDRESTART_MODE=l
      exec > /var/log/shield/00-shield.log 2>&1

      # Rename NICs to wan0/lan0 by MAC NOW (first boot): cloud-init wrote the
      # udev rule after coldplug, so this boot's udev never saw it and netplan
      # match+rename does not apply until the next coldplug. Without this,
      # dnsmasq's interface=lan0 fails with "unknown interface lan0".
      rename_if() {   # $1=mac  $2=target name
          local cur
          cur=$(ip -o link show | awk -v m="$1" 'index(tolower($0), m) {print $2}' | cut -d: -f1 | cut -d@ -f1)
          [ "$cur" = "$2" ] && return 0
          [ -n "$cur" ] || { echo "ERROR: no interface with mac $1"; return 1; }
          ip link set "$cur" down
          ip link set "$cur" name "$2"
      }
      rename_if ${wan_mac} wan0
      rename_if ${lan_mac} lan0
      # netplan apply, NOT networkctl reload: reload leaves freshly renamed
      # NICs DOWN with no config; apply re-runs the MAC-matched definitions
      # against the new names and brings DHCP/static up.
      netplan apply
      for _ in $(seq 1 60); do ip -4 route show default | grep -q via && break; sleep 2; done
      ip -4 route show default | grep -q via || { echo "ERROR: no default route after rename"; exit 1; }

      apt-get update -qq
      apt-get install -y dnsmasq nftables conntrack

      # nft ruleset first: dnsmasq nftset= needs the allow4 set to exist
      # (persisted: nftables.service loads /etc/nftables.conf at boot)
      # 'flush ruleset' makes every 'nft -f' a full atomic replace: without it
      # nft -f MERGES into the live ruleset, duplicating the chain's rules —
      # the stale first copy's terminal 'reject' then shadows the fresh rules
      # (observed: deny-logging fix applied but packets still hit the old
      # reject above it).
      cat > /etc/nftables.conf <<'NEOF'
      flush ruleset

      table inet shield {
          set allow4 {
              type ipv4_addr
              flags dynamic,timeout
              timeout 30m
          }
          chain forward {
              type filter hook forward priority 0; policy drop;
              ct state established,related accept
              ct state invalid drop
              # NOTE: no bare { } statement blocks in nft — a brace after a
              # match parses as an anonymous set; repeat the match per rule.
              iifname "lan0" oifname "wan0" ip daddr @allow4 tcp dport { 80, 443 } counter accept
              iifname "lan0" oifname "wan0" ip daddr @allow4 udp dport 443 counter accept
              iifname "lan0" oifname "wan0" ip daddr @allow4 udp dport 123 counter accept
              # legible deny for the agent: RST / icmp port-unreachable + a log
              # line, instead of a silent timeout (nft 1.0.9 only accepts
              # port-unreachable as the icmpx type keyword).
              # LOG MUST COME FIRST: reject is a terminal verdict, so a log
              # rule after it never sees the rejected packets (observed: zero
              # [shield-drop] lines while denies worked fine). Rate limit only
              # guards the log volume — keep it above a realistic browsing
              # burst (a page load fires many denied flows), else deny lines
              # and shield-suggest.sh's snapshot go missing.
              iifname "lan0" limit rate 60/minute burst 20 packets counter log prefix "[shield-drop] "
              iifname "lan0" counter reject with icmpx type port-unreachable
          }
          chain input {
              type filter hook input priority 0; policy accept;
              iifname "wan0" ct state invalid drop
              # the agent VM must not SSH into the shield (its gateway); operator
              # SSH arrives from the libvirt bridge addresses
              iifname "lan0" ip saddr != ${box_host} tcp dport 22 counter drop
              iifname "wan0" ip saddr != 192.168.122.1 tcp dport 22 counter drop
          }
          chain postrouting {
              type nat hook postrouting priority 100;
              oifname "wan0" masquerade
          }
      }
      NEOF
      nft -f /etc/nftables.conf
      systemctl enable nftables

      echo 'net.ipv4.ip_forward = 1' > /etc/sysctl.d/99-shield-forward.conf
      sysctl -q -w net.ipv4.ip_forward=1

      # dnsmasq: agent's only resolver. nftset= lines mirror allowed domains'
      # IPs into allow4 (dnsmasq >= 2.86; Ubuntu 24.04 has 2.90). port=53 is
      # set explicitly so the Debian dnsmasq-check passes despite the
      # systemd-resolved stub on this box. Upstream is upstream DNS of the
      # NATed libvirt default network; a UiO profile would pin UiO resolvers.
      cat > /etc/dnsmasq.conf <<DEOF
      interface=lan0
      bind-interfaces
      port=53
      domain-needed
      bogus-priv
      localise-queries
      log-queries
      no-poll
      # min-cache-ttl >= set timeout: dnsmasq's nftset entries inherit the
      # (extended) record TTL, so short-TTL domains (github: ~48s) don't get
      # their allow4 lifetime downgraded below the keepalive interval.
      min-cache-ttl=1800
      server=8.8.8.8
      server=1.1.1.1
      DEOF
      # allow_domains is rendered as ONE line (space-separated) by deploy-local.sh;
      # emitting lines here avoids injecting newlines into the YAML block scalar.
      for d in ${allow_domains}; do echo "nftset=/$d/4#inet#shield#allow4" >> /etc/dnsmasq.conf; done
      systemctl enable --now dnsmasq

  - path: /usr/local/lib/shield/monitor.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      # shield-report: one-screen audit of the agent VM's network behavior.
      # Usage: shield-report [since-duration]  (default: last 1 hour)
      # Runs automatically via shield-monitor.timer (every 10 min) -> journalctl -u shield-monitor
      SINCE="${1:-1 hour}"
      echo "===== shield report $(date -Is) (since: $SINCE) ====="
      echo "-- nft forward rules (with counters) --"
      nft -a list chain inet shield forward 2>/dev/null | grep counter
      echo "-- live allow4 entries (resolved IPs behind allowed domains) --"
      nft -a list set inet shield allow4 2>/dev/null | grep -v '^\s*}' | tail -25
      echo "-- denies seen from agent (kernel log) --"
      journalctl -k --since "$SINCE ago" -q 2>/dev/null | grep -F '[shield-drop]' | tail -20
      echo "-- agent DNS queries, top 15 --"
      journalctl -u dnsmasq --since "$SINCE ago" -q 2>/dev/null \
        | grep -oE 'query\([A-Z]+\) [^ ]+' | awk '{print $2}' | sort | uniq -c | sort -rn | head -15
      echo "-- live connections through the shield (conntrack) --"
      conntrack -L 2>/dev/null | grep -oE 'dst=[0-9.]+' | sort | uniq -c | sort -rn | head -10

  - path: /usr/local/lib/shield/keepalive.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      # keepalive.sh — refresh allow4 membership for every profile domain.
      # Why needed: dnsmasq mirrors a domain's IPs into allow4 only when it
      # receives an UPSTREAM reply; long-TTL records (e.g. 48-min TTL) are not
      # re-fetched before the set's 30-min element timeout, so allowlisted
      # access silently lapses. Re-resolve (dnsmasq answers from its own cache,
      # no upstream traffic) and reset each element's timer with separate
      # nft delete + nft add calls. The timer fires every 4 min, far below the
      # 30-min expiry: no gap.
      set -u
      # Build the wanted set: every IP that a still-profiled domain CURRENTLY
      # answers with (dnsmasq's own view = what agents actually receive).
      WANT=()
      for d in $(grep -oP '(?<=nftset=/)[^/]+(?=/4#inet#shield#allow4)' /etc/dnsmasq.conf); do
          for ip in $(dig +short A "$d" @127.0.0.1 | grep -E '^([0-9]{1,3}\.){3}[0-9]{1,3}$'); do
              WANT+=("$ip")
          done
      done
      for ip in "${WANT[@]}"; do
          # NOTE: two separate nft calls. Putting both statements (plus
          # "2>/dev/null") inside ONE quoted nft string makes nft itself
          # parse the redirect -> syntax error -> silent no-op.
          nft delete element inet shield allow4 "{ $ip }" 2>/dev/null || true
          nft add element inet shield allow4 "{ $ip }" 2>/dev/null || true
      done
      # Garbage-collect stale generations: round-robin/CDN domains rotate
      # their RRset, and a revoked domain's cached IPs can't be re-discovered
      # by digging it (its line is gone from dnsmasq.conf). Anything in the
      # set that no profile domain currently answers gets deleted here —
      # otherwise such entries sit out their 30-min timer and keep a revoked
      # site reachable (observed: nevron.no CDN IPs survived its revoke).
      for ip in $(nft list set inet shield allow4 | grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}' | sort -u); do
          case " ${WANT[*]} " in
              *" $ip "*) continue ;;
          esac
          nft delete element inet shield allow4 "{ $ip }" 2>/dev/null || true
          conntrack -D -r "$ip" >/dev/null 2>&1 || true
      done

  - path: /etc/systemd/system/shield-keepalive.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Refresh allow4 entries for shield profile domains
      [Service]
      Type=oneshot
      ExecStart=/usr/local/lib/shield/keepalive.sh

  - path: /etc/systemd/system/shield-keepalive.timer
    permissions: '0644'
    content: |
      [Unit]
      Description=Refresh allow4 every 4 minutes
      [Timer]
      OnBootSec=2min
      OnUnitActiveSec=4min
      AccuracySec=30s
      [Install]
      WantedBy=timers.target

  - path: /usr/local/bin/shield-report
    permissions: '0755'
    content: |
      #!/bin/bash
      exec /usr/local/lib/shield/monitor.sh "$@"

  - path: /etc/systemd/system/shield-monitor.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Shield network audit snapshot
      [Service]
      Type=oneshot
      ExecStart=/usr/local/lib/shield/monitor.sh

  - path: /etc/systemd/system/shield-monitor.timer
    permissions: '0644'
    content: |
      [Unit]
      Description=shield-report every 10 minutes
      [Timer]
      OnBootSec=5min
      OnUnitActiveSec=10min
      [Install]
      WantedBy=timers.target

runcmd:
  - mkdir -p /var/log/shield
  - bash /usr/local/lib/shield/00-shield.sh
  - systemctl daemon-reload
  - systemctl enable --now shield-monitor.timer
  - systemctl enable --now shield-keepalive.timer
  - /usr/local/lib/shield/keepalive.sh

final_message: |
  Shield ready. Profile applied via nftset (see /etc/dnsmasq.conf).
  Audit: sudo shield-report   History: journalctl -u shield-monitor
