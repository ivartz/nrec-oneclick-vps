#cloud-config

package_update: false
package_upgrade: false

timezone: Europe/Oslo

users:
  - name: ${admin_user}
    sudo: ALL=(ALL) NOPASSWD:ALL
    groups: render, video, sudo
    shell: /bin/bash
    lock_passwd: false
    ssh_authorized_keys:
      - ${ssh_public_key}

chpasswd:
  expire: false
  users:
    - name: ${admin_user}
      password: ${admin_password}
      type: text

write_files:

  - path: /usr/local/lib/vps-desktop/01-desktop.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -euo pipefail
      export DEBIAN_FRONTEND=noninteractive
      export HOME=/root
      exec > /var/log/vps-desktop/01-desktop.log 2>&1

      apt-get update -qq
      export NEEDRESTART_MODE=l
      apt-get install -y gnome-shell gnome-session gdm3 gnome-terminal \
        nautilus gnome-control-center gnome-keyring gnome-backgrounds \
        libgl1-mesa-dri xserver-xorg-video-all gnome-session-flashback \
        gnome-calculator gnome-system-monitor gnome-disk-utility \
        eog evince gnome-text-editor baobab gnome-logs gnome-screenshot \
        dmz-cursor-theme \
        ripgrep ffmpeg xvfb dbus-x11 \
        fonts-liberation fonts-noto-color-emoji fonts-ubuntu
      systemctl disable --now snapd 2>/dev/null || true
      systemctl disable --now NetworkManager-wait-online 2>/dev/null || true
      systemctl disable --now ModemManager 2>/dev/null || true
      chmod 000 /usr/libexec/gsd-usb-protection 2>/dev/null || true
      curl -fsSL "${turbovnc_deb_url}" -o /tmp/turbovnc.deb
      dpkg -i /tmp/turbovnc.deb || apt-get install -f -y
      rm -f /tmp/turbovnc.deb
      export PATH=/opt/TurboVNC/bin:$PATH
      echo 'export PATH=/opt/TurboVNC/bin:$PATH' > /etc/profile.d/turbovnc.sh

      mkdir -p /home/${admin_user}/.vnc
      echo "${admin_password}" | vncpasswd -f > /home/${admin_user}/.vnc/passwd 2>/dev/null || true
      chmod 600 /home/${admin_user}/.vnc/passwd
      chown -R ${admin_user}:${admin_user} /home/${admin_user}/.vnc
      # Write full-length password (vncpasswd truncates to 8 chars)
      printf '%s' "${admin_password}" > /home/${admin_user}/.vnc-passwd
      chmod 600 /home/${admin_user}/.vnc-passwd
      chown ${admin_user}:${admin_user} /home/${admin_user}/.vnc-passwd

      # Add TurboVNC to PATH for all interactive shells (non-login)
      echo '' >> /home/${admin_user}/.bashrc
      echo '# Add TurboVNC to PATH for all shells' >> /home/${admin_user}/.bashrc
      echo 'export PATH=/opt/TurboVNC/bin:$PATH' >> /home/${admin_user}/.bashrc

      # Install turbovncserver.conf
      cat /usr/local/lib/vps-desktop/turbovncserver.conf >> /etc/turbovncserver.conf

  - path: /usr/local/lib/vps-desktop/turbovncserver.conf
    permissions: '0644'
    content: |
      $wm = "gnome-flashback-metacity";
      $userDBus = 1;

  - path: /usr/local/lib/vps-desktop/02-chromium.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -euo pipefail
      export HOME=/root
      exec > /var/log/vps-desktop/02-chromium.log 2>&1

      wget -SL -O /tmp/google-chrome-stable.deb https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb
      dpkg -i /tmp/google-chrome-stable.deb || apt-get install -f -y
      rm -f /tmp/google-chrome-stable.deb

runcmd:
  - mkdir -p /var/log/vps-desktop
  # Prevent apt lock contention during provisioning
  - systemctl stop apt-daily.timer apt-daily-upgrade.timer unattended-upgrades 2>/dev/null || true
  - systemctl mask apt-daily.timer apt-daily-upgrade.timer 2>/dev/null || true
  - systemctl mask sssd 2>/dev/null || true
  - systemctl mask gnome-remote-desktop 2>/dev/null || true
  - bash /usr/local/lib/vps-desktop/01-desktop.sh
  - bash /usr/local/lib/vps-desktop/02-chromium.sh

final_message: |
  VPS ready. Start VNC: vncserver :1
  Modern GNOME: vncserver :1 -wm gnome
  Connect: ssh -L 55901:localhost:5901 -i <key> ubuntu@<ip>, then vncviewer localhost:55901
  VNC password: ${admin_password}
